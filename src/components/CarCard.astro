---
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import type { Car } from '../data/cars';

interface Props {
  car: Car;
  /** featured: "Em destaque" · grid: "Todo o estoque" · mini: "Veja também" */
  variant?: 'featured' | 'grid' | 'mini';
}

const { car, variant = 'grid' } = Astro.props;
const href = url(`carros/${car.slug}/`);
const sizes = {
  featured: '(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 420px',
  grid: '(max-width: 560px) 100vw, (max-width: 1100px) 50vw, 320px',
  mini: '(max-width: 560px) 100vw, (max-width: 1100px) 50vw, 320px',
}[variant];
const Tag = variant === 'mini' ? 'a' : 'article';
---

<Tag
  class:list={['car-card', `car-card--${variant}`]}
  href={variant === 'mini' ? href : undefined}
  data-car
  data-name={car.nome.toLowerCase()}
  data-cats={car.categorias.join(' ')}
>
  <Image src={car.fotos[0]} alt={car.nome} widths={[400, 640, 900]} sizes={sizes} />
  <div class="car-card__body">
    <h3 class="car-card__name">{car.nome}</h3>
    {variant !== 'mini' && <p class="car-card__meta">{car.ano} · {car.km} km</p>}
    <p class="price car-card__price">{car.preco}</p>
    {variant !== 'mini' && <a href={href} class="btn btn-outline car-card__btn">Ver detalhes</a>}
  </div>
</Tag>

<style>
  .car-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    transition: border-color 0.2s;
  }
  .car-card:hover {
    border-color: #3d423f;
    color: var(--text);
  }
  img {
    width: 100%;
    height: 190px;
    object-fit: cover;
  }
  .car-card__body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
    padding: 16px;
  }
  .car-card__name {
    font-size: 1rem;
    text-transform: none;
    line-height: 1.25;
  }
  .car-card__meta {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .car-card__price {
    margin-top: 4px;
    font-size: 1.0625rem;
  }
  .car-card__btn {
    margin-top: auto;
    padding: 13px 10px;
    font-size: 0.8125rem;
  }
  .car-card__price + .car-card__btn {
    margin-top: 10px;
  }

  .car-card--featured img {
    height: 260px;
  }
  .car-card--featured .car-card__body {
    gap: 6px;
    padding: 20px;
  }
  .car-card--featured .car-card__name {
    font-size: 1.25rem;
  }
  .car-card--featured .car-card__meta {
    font-size: 0.875rem;
  }
  .car-card--featured .car-card__price {
    margin-top: 6px;
    font-size: 1.375rem;
  }
  .car-card--featured .car-card__btn {
    margin-top: 14px;
    padding: 13px;
    font-size: 0.875rem;
  }

  .car-card--mini img {
    height: 180px;
  }
  .car-card--mini .car-card__price {
    font-size: 1rem;
  }
  .car-card--mini:hover .car-card__name {
    color: var(--accent);
  }
</style>
