---
import Icon from './Icon.astro';

const items = [
  {
    icon: 'shield',
    tone: 'teal',
    title: 'Revisão completa',
    text: 'Cada carro passa por checklist mecânico antes de entrar no estoque.',
  },
  {
    icon: 'camera',
    tone: 'accent',
    title: 'Fotos reais, sem enganação',
    text: 'O carro que você vê no anúncio é exatamente o que chega até você.',
  },
  {
    icon: 'headset',
    tone: 'teal',
    title: 'Suporte direto',
    text: 'Fala com quem vende, sem call center nem intermediário.',
  },
] as const;
---

<section class="features" id="diferenciais" aria-label="Diferenciais">
  <div class="container features__grid">
    {
      items.map((f) => (
        <div class="feature">
          <span class:list={['feature__icon', `feature__icon--${f.tone}`]}>
            <Icon name={f.icon} size={26} />
          </span>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features {
    padding-block: 72px;
    background: var(--surface);
    border-block: 1px solid var(--border);
  }
  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
  }
  .feature__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
  }
  .feature__icon--teal {
    background: rgb(63 163 156 / 0.18);
    color: var(--teal);
  }
  .feature__icon--accent {
    background: rgb(210 98 42 / 0.18);
    color: var(--accent);
  }
  h3 {
    margin-top: 16px;
    text-transform: none;
  }
  p {
    margin-top: 8px;
    max-width: 280px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .features {
      padding-block: 56px;
    }
    .features__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
