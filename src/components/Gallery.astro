---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  fotos: ImageMetadata[];
  nome: string;
  cor: string;
}

const { fotos, nome, cor } = Astro.props;
---

<div class="gallery" data-gallery>
  <div class="gallery__main">
    {
      fotos.map((foto, i) => (
        <Image
          src={foto}
          alt={i === 0 ? `${nome} ${cor.toLowerCase()}` : `${nome}, foto ${i + 1} de ${fotos.length}`}
          widths={[640, 960, 1400, 1920]}
          sizes="(max-width: 960px) 100vw, 800px"
          priority={i === 0}
          data-slide={i}
          hidden={i !== 0}
        />
      ))
    }
  </div>

  {
    fotos.length > 1 && (
      <div class="gallery__thumbs" role="group" aria-label="Fotos do veículo">
        {fotos.map((foto, i) => (
          <button
            type="button"
            class="gallery__thumb"
            data-thumb={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={`Ver foto ${i + 1} de ${fotos.length}`}
          >
            <Image src={foto} alt="" widths={[200, 400]} sizes="200px" />
          </button>
        ))}
      </div>
    )
  }

  <p class="gallery__credit">Foto: Aragão Auto</p>
</div>

<style>
  .gallery__main {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .gallery__main img {
    width: 100%;
    height: 560px;
    object-fit: cover;
    animation: fade 0.3s ease;
  }
  @keyframes fade {
    from {
      opacity: 0.5;
    }
  }
  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }
  .gallery__thumb {
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 8px;
    background: var(--surface);
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .gallery__thumb:hover {
    opacity: 1;
  }
  .gallery__thumb[aria-pressed='true'] {
    border-color: var(--teal);
    opacity: 1;
  }
  .gallery__thumb img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .gallery__credit {
    margin-top: 12px;
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .gallery__main img {
      height: auto;
      aspect-ratio: 3 / 2;
    }
  }
  @media (max-width: 480px) {
    .gallery__thumbs {
      gap: 8px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLImageElement>('[data-slide]')];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]')];

    thumbs.forEach((thumb, index) =>
      thumb.addEventListener('click', () => {
        slides.forEach((s, i) => (s.hidden = i !== index));
        thumbs.forEach((t, i) => t.setAttribute('aria-pressed', String(i === index)));
      }),
    );
  });
</script>
