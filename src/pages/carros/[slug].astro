---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import FinanceSim from '../../components/FinanceSim.astro';
import CarCard from '../../components/CarCard.astro';
import Icon from '../../components/Icon.astro';
import { cars, categoriaLabel, vejaTambem, type Car } from '../../data/cars';
import { whatsappLink } from '../../data/site';
import { url } from '../../lib/url';

export const getStaticPaths = (() =>
  cars.map((car) => ({ params: { slug: car.slug }, props: { car } }))) satisfies GetStaticPaths;

interface Props {
  car: Car;
}
const { car } = Astro.props;

const specs = [
  { label: 'Ano', value: car.ano },
  { label: 'Quilometragem', value: `${car.km} km` },
  { label: 'Câmbio', value: car.cambio },
  { label: 'Combustível', value: car.combustivel },
  { label: 'Cor', value: car.cor },
  { label: 'Motor', value: car.motor },
];

const categoriaPrincipal = car.categorias[0];
const itens = Array.from({ length: 4 }, () => '[Item ou opcional]');
const relacionados = vejaTambem(car, 4);
const wa = whatsappLink(`Olá! Tenho interesse no ${car.nome} que vi no site da Vertex Auto.`);
---

<Base title={car.nome} description={`${car.nome} à venda na Vertex Auto. ${car.descricao[0]}`}>
  <div class="container">
    <nav class="crumbs" aria-label="Navegação estrutural">
      <a href={url('#estoque')}>Estoque</a>
      <span aria-hidden="true">/</span>
      <a href={url(`?cat=${categoriaPrincipal}#estoque`)}>{categoriaLabel[categoriaPrincipal]}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{car.nome}</span>
    </nav>

    <div class="two-col top">
      <Gallery fotos={car.fotos} nome={car.nome} cor={car.cor} />

      <div class="info">
        <div class="badges">
          {car.categorias.map((c, i) => <span class:list={['badge', { 'badge--accent': i % 2 === 1 }]}>{categoriaLabel[c]}</span>)}
        </div>
        <h1>{car.nome}</h1>
        <p class="price info__price">{car.preco}</p>

        <dl class="specs">
          {
            specs.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="actions">
          <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> Falar no WhatsApp
          </a>
          <a class="btn btn-outline" href={url(`sobre/?carro=${car.slug}#contato`)}>Agendar visita</a>
        </div>
      </div>
    </div>

    <div class="two-col bottom">
      <section class="about">
        <h2>Sobre este carro</h2>
        {car.descricao.map((p) => <p>{p}</p>)}
        <h3>Itens e observações</h3>
        <ul class="itens">
          {itens.map((i) => <li>{i}</li>)}
        </ul>
      </section>

      <FinanceSim />
    </div>

    <section class="related">
      <h2>Veja também</h2>
      <div class="related__grid">
        {relacionados.map((c) => <CarCard car={c} variant="mini" />)}
      </div>
    </section>
  </div>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 28px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .crumbs [aria-current] {
    color: var(--text);
    font-weight: 600;
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 48px;
  }
  .top {
    padding-top: 24px;
  }
  .bottom {
    padding-top: 64px;
    align-items: start;
  }

  .info {
    display: flex;
    flex-direction: column;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .info h1 {
    margin-top: 16px;
    font-size: clamp(2.2rem, 3.4vw, 3rem);
  }
  .info__price {
    margin-top: 14px;
    font-size: clamp(1.8rem, 2.4vw, 2.125rem);
  }
  .specs {
    margin: 24px 0 0;
    border-top: 1px solid var(--border);
  }
  .specs div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
  }
  .specs dt {
    color: var(--muted);
  }
  .specs dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 28px;
  }
  .actions .btn {
    padding: 16px;
  }

  .about h2 {
    margin-bottom: 16px;
    font-size: 1.75rem;
  }
  .about p {
    max-width: 720px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .about p + p {
    margin-top: 12px;
  }
  .about h3 {
    margin: 32px 0 12px;
  }
  .itens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text-soft);
  }
  .itens li::before {
    content: '• ';
  }

  .related {
    padding-block: 72px 80px;
  }
  .related h2 {
    margin-bottom: 28px;
    font-size: 1.75rem;
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 1100px) {
    .related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 960px) {
    .two-col {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .bottom {
      padding-top: 48px;
      gap: 40px;
    }
    .related {
      padding-block: 56px;
    }
  }
  @media (max-width: 480px) {
    .itens {
      grid-template-columns: 1fr;
    }
    .related__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
